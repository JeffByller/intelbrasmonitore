# ========================================================
# Exemplo de Configuração de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com suas senhas:
# cp .env.example .env
# ========================================================

# Credenciais do Banco de Dados PostgreSQL
POSTGRES_USER=monitor_user
POSTGRES_PASSWORD=sua_senha_segura_do_banco_aqui
POSTGRES_DB=monitor_db
DATABASE_URL=postgresql+asyncpg://monitor_user:sua_senha_segura_do_banco_aqui@db:5432/monitor_db

# Credenciais e Segurança da Aplicação
ADMIN_PASSWORD=sua_senha_master_de_acesso_aqui
SECRET_KEY=gere_uma_chave_secreta_aleatoria_longa_aqui

# Configurações Gerais
TZ=America/Recife
PORT=8085
